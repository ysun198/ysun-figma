{
  "name": "figma-plugin-local",
  "version": "0.27.1",
  "private": true,
  "description": "ysun figma：在 Codex 中读取、编辑和导出 Figma 设计",
  "license": "MIT",
  "distributionFiles": [
    "LICENSE",
    "NOTICE.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md",
    "app.html",
    "assets/",
    "docs/ARCHITECTURE.md",
    "docs/INSTALL.md",
    "docs/PRIVACY.md",
    "manifest.json",
    "mcp.json",
    "plugin-runtime.js",
    "plugin.json",
    "scripts/launch-mcp.sh",
    "scripts/run-node.sh",
    "skills/",
    "src/host/account-reader.js",
    "src/host/app.cjs",
    "src/host/artifact-client.cjs",
    "src/host/artifacts.cjs",
    "src/host/bridge-client.cjs",
    "src/host/bridge-server.cjs",
    "src/host/catalog-sync.cjs",
    "src/host/catalog.cjs",
    "src/host/codex-refresh.cjs",
    "src/host/desktop.cjs",
    "src/host/companion.cjs",
    "src/host/execution.cjs",
    "src/host/installation.cjs",
    "src/host/launch-mcp.cjs",
    "src/host/mcp.cjs",
    "src/host/state.cjs",
    "src/host/targets.cjs",
    "src/host/update-service.cjs",
    "src/host/updates.cjs",
    "src/shared/core.js",
    "src/shared/version.js",
    "ui.html"
  ],
  "scripts": {
    "format": "prettier --write src scripts test docs .github/workflows README*.md NOTICE.md eslint.config.cjs package.json plugin.json manifest.json mcp.json .prettierrc.json",
    "format:check": "prettier --check src scripts test docs .github/workflows README*.md NOTICE.md eslint.config.cjs package.json plugin.json manifest.json mcp.json .prettierrc.json",
    "lint": "eslint src scripts test eslint.config.cjs --max-warnings 0",
    "build": "node scripts/build.cjs",
    "pretest": "node scripts/build.cjs",
    "test": "node --test --test-concurrency=4 --test-timeout=20000 test/*.test.cjs",
    "check": "npm run format:check && npm run lint && node scripts/build.cjs --check && node scripts/check.cjs",
    "release": "npm test && npm run check && node scripts/release.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ysun198/ysun-figma.git"
  },
  "updates": {
    "publicKey": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAqH4qEc07XOyhjd8aBHKtcjOMqY4N7jp2daPv+jr4zm8=\n-----END PUBLIC KEY-----\n"
  }
}
